@template.layout(
    title = "Terms of Service | LifeVerdict",
    description = "Terms of service for using the LifeVerdict inspection response tool.",
    content = @`
        <div class="support-shell">
            <section class="support-hero">
                <div class="section-kicker">Terms of service</div>
                <h1 class="support-title">Use LifeVerdict as an informational decision-support tool.</h1>
                <p class="support-lede">
                    By using LifeVerdict, you agree that the service provides informational packet outputs and workflow support rather than binding professional opinions or guaranteed quotes.
                </p>
                <div class="support-meta">
                    <span>Informational service</span>
                    <span>User verification required</span>
                    <span>Updated April 23, 2026</span>
                </div>
            </section>

            <section class="support-grid">
                <article class="support-card">
                    <h2>Nature of the service</h2>
                    <p>
                LifeVerdict generates ask pre-send reviews and response packets from user-provided inspection information, evidence matching, and model-driven sizing logic. It is not a substitute for licensed engineering, legal, brokerage, lending, inspection, or contractor advice.
                    </p>
                </article>

                <article class="support-card">
                    <h2>User responsibility</h2>
                    <p>
                        You are responsible for reviewing the packet before using it, confirming OCR-marked citations against the source page, and making your own decisions about real-estate negotiations and repair scope.
                    </p>
                </article>

                <article class="support-card">
                    <h2>No warranty of outcomes</h2>
                    <p>
                        We do not guarantee seller responses, lender treatment, appraisal outcomes, contractor pricing, or the commercial results of any negotiation strategy.
                    </p>
                </article>
            </section>

            <section class="support-grid mt-5">
                <article class="support-card">
                    <h2>Permitted use</h2>
                    <p>
                        You may use the packet for your own transaction workflow, client workflow, or internal evaluation. You may not scrape, resell, or mass-reproduce the product or its data without permission.
                    </p>
                </article>

                <article class="support-card">
                    <h2>Limitation of liability</h2>
                    <p>
                        To the fullest extent permitted by law, LifeVerdict is not liable for losses or damages arising from reliance on packet outputs, negotiation decisions, or third-party pricing and professional advice.
                    </p>
                </article>

                <article class="support-card">
                    <h2>Contact</h2>
                    <p>
                        For questions about these terms, contact <a href="mailto:support@lifeverdict.com">support@lifeverdict.com</a>.
                    </p>
                </article>
            </section>
        </div>
    `
)
